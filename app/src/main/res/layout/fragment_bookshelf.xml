<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bookshelf_bg">

    <TextView
        android:id="@+id/tv_bookshelf_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="16dp"
        android:text="知页"
        android:textColor="@color/zy_text_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/iv_bookshelf_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_bookshelf_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:text="继续读一本书，世界就安静一点"
        android:textColor="@color/zy_text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/iv_bookshelf_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_bookshelf_title" />

    <ImageView
        android:id="@+id/iv_bookshelf_add"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="42dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/zy_card"
        android:elevation="@dimen/zy_elevation_card"
        android:padding="12dp"
        android:src="@drawable/bookshelf_add"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_bookshelf_add"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:text="@string/bookshelf_add"
        android:textColor="@color/zy_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/iv_bookshelf_add"
        app:layout_constraintEnd_toStartOf="@id/iv_bookshelf_add"
        app:layout_constraintTop_toTopOf="@id/iv_bookshelf_add" />

    <android.support.constraint.ConstraintLayout
        android:id="@+id/cl_bookshelf_continue"
        android:layout_width="0dp"
        android:layout_height="156dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/zy_card"
        android:clickable="true"
        android:elevation="@dimen/zy_elevation_card"
        android:focusable="true"
        android:padding="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_bookshelf_subtitle">

        <ImageView
            android:id="@+id/iv_bookshelf_continue_cover"
            android:layout_width="78dp"
            android:layout_height="116dp"
            android:background="@drawable/zy_cover_bg"
            android:scaleType="centerCrop"
            android:src="@drawable/default_cover"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_bookshelf_continue_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="继续阅读"
            android:textColor="@color/zy_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_bookshelf_continue_cover"
            app:layout_constraintTop_toTopOf="@id/iv_bookshelf_continue_cover" />

        <TextView
            android:id="@+id/tv_bookshelf_continue_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="还没有正在阅读的书"
            android:textColor="@color/zy_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_bookshelf_continue_cover"
            app:layout_constraintTop_toBottomOf="@id/tv_bookshelf_continue_label" />

        <TextView
            android:id="@+id/tv_bookshelf_continue_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="导入一本书后会显示阅读进度"
            android:textColor="@color/zy_text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_bookshelf_continue_cover"
            app:layout_constraintTop_toBottomOf="@id/tv_bookshelf_continue_name" />

        <View
            android:id="@+id/v_bookshelf_continue_progress"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/zy_chip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_bookshelf_continue_cover"
            app:layout_constraintTop_toBottomOf="@id/tv_bookshelf_continue_progress" />
    </android.support.constraint.ConstraintLayout>

    <TextView
        android:id="@+id/tv_bookshelf_section_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="26dp"
        android:text="我的书架"
        android:textColor="@color/zy_text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_bookshelf_continue" />

    <View
        android:id="@+id/v_bookshelf_separator"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:background="@color/zy_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_bookshelf_section_title" />

    <android.support.v7.widget.RecyclerView
        android:id="@+id/rv_bookshelf_bookshelf_novels_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="14dp"
        android:paddingTop="16dp"
        android:paddingEnd="14dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_bookshelf_separator" />

    <RelativeLayout
        android:id="@+id/rv_bookshelf_loading"
        android:layout_width="180dp"
        android:layout_height="132dp"
        android:background="@drawable/zy_card"
        android:elevation="@dimen/zy_elevation_card"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:indeterminateTint="@color/zy_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:text="正在导入图书..."
            android:textColor="@color/zy_text_primary"
            android:textSize="15sp" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rv_bookshelf_multi_delete_bar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@drawable/zy_bottom_sheet"
        android:clickable="true"
        android:elevation="@dimen/zy_elevation_nav"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_bookshelf_multi_delete_select_all"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:gravity="center"
            android:text="@string/bookshelf_multi_delete_select_all"
            android:textColor="@color/zy_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_bookshelf_multi_delete_delete"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:text="@string/bookshelf_multi_delete_delete"
            android:textColor="#E7544D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_bookshelf_multi_delete_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="18dp"
            android:layout_toStartOf="@id/tv_bookshelf_multi_delete_delete"
            android:gravity="center"
            android:text="@string/bookshelf_multi_delete_cancel"
            android:textColor="@color/zy_text_secondary"
            android:textSize="16sp" />
    </RelativeLayout>

</android.support.constraint.ConstraintLayout>
