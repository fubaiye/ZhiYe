<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/more_bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_source_manager_title"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center"
        android:text="书源管理"
        android:textColor="@color/more_text"
        android:textSize="18sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/et_source_manager_json"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@android:color/white"
                android:gravity="top|start"
                android:hint="粘贴或编辑 BookSource JSON"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="@color/more_text"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_source_manager_url"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@android:color/white"
                android:hint="书源 JSON URL"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/more_text"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_source_manager_clipboard"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="剪贴板" />

                <Button
                    android:id="@+id/btn_source_manager_url"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="URL" />

                <Button
                    android:id="@+id/btn_source_manager_qr"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="二维码" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_source_manager_save"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="导入/保存" />

                <Button
                    android:id="@+id/btn_source_manager_export"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="导出全部" />

                <Button
                    android:id="@+id/btn_source_manager_debug"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="调试" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_source_manager_enable_all"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="全部开启" />

            <LinearLayout
                android:id="@+id/ll_source_manager_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
