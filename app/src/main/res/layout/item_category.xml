<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/discovery_bg"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_item_category_category_name"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_alignParentStart="true"
        android:gravity="center"
        android:text="@string/item_category_category_name"
        android:textColor="@color/item_category_category_name"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/iv_item_category_more"
        android:layout_width="18dp"
        android:layout_height="36dp"
        android:layout_alignParentEnd="true"
        android:scaleType="centerInside"
        android:src="@drawable/item_category_more" />

    <TextView
        android:id="@+id/tv_item_category_more"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_toStartOf="@id/iv_item_category_more"
        android:gravity="center"
        android:text="@string/item_category_more"
        android:textColor="@color/item_category_more"
        android:textSize="14sp" />

    <android.support.v7.widget.RecyclerView
        android:id="@+id/rv_item_category_novel_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_item_category_category_name"
        android:layout_marginTop="12dp"
        android:background="@drawable/zy_card"
        android:clipToPadding="false"
        android:elevation="@dimen/zy_elevation_card"
        android:paddingStart="8dp"
        android:paddingTop="14dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp" />

</RelativeLayout>
