<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/more_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="42dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/tv_more_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/more_top_text"
            android:textColor="@color/zy_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/zy_card"
            android:elevation="@dimen/zy_elevation_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/zy_primary_pill"
                android:gravity="center"
                android:text="知"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="知页阅读"
                    android:textColor="@color/zy_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="本地书架、在线书库与自托管更新"
                    android:textColor="@color/zy_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="阅读与书库"
            android:textColor="@color/zy_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/zy_card"
            android:elevation="@dimen/zy_elevation_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/v_more_online_library"
                style="@style/ZySettingsRow"
                android:clickable="true"
                android:focusable="true">

                <ImageView style="@style/ZySettingsIcon" android:src="@drawable/zy_ic_discover_filled" />
                <TextView style="@style/ZySettingsTitle" android:text="在线书库" />
                <TextView style="@style/ZySettingsChevron" android:text="›" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/v_more_source_manager"
                style="@style/ZySettingsRow"
                android:clickable="true"
                android:focusable="true">

                <ImageView style="@style/ZySettingsIcon" android:src="@drawable/more_about" />
                <TextView style="@style/ZySettingsTitle" android:text="书源管理" />
                <TextView style="@style/ZySettingsChevron" android:text="›" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="数据"
            android:textColor="@color/zy_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/zy_card"
            android:elevation="@dimen/zy_elevation_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/v_more_clear"
                style="@style/ZySettingsRow"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_more_clear"
                    style="@style/ZySettingsIcon"
                    android:src="@drawable/more_clear" />
                <TextView style="@style/ZySettingsTitle" android:text="@string/more_clear" />
                <TextView
                    android:id="@+id/tv_more_cache_size"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/more_cache_size"
                    android:textColor="@color/more_text_light"
                    android:textSize="14sp" />
                <TextView style="@style/ZySettingsChevron" android:text="›" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/v_more_backup"
                style="@style/ZySettingsRow"
                android:clickable="true"
                android:focusable="true">

                <ImageView style="@style/ZySettingsIcon" android:src="@drawable/more_after" />
                <TextView style="@style/ZySettingsTitle" android:text="备份数据" />
                <TextView style="@style/ZySettingsChevron" android:text="›" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/v_more_restore"
                style="@style/ZySettingsRow"
                android:clickable="true"
                android:focusable="true">

                <ImageView style="@style/ZySettingsIcon" android:src="@drawable/more_before" />
                <TextView style="@style/ZySettingsTitle" android:text="恢复备份" />
                <TextView style="@style/ZySettingsChevron" android:text="›" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="关于"
            android:textColor="@color/zy_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/zy_card"
            android:elevation="@dimen/zy_elevation_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/v_more_check_update"
                style="@style/ZySettingsRow"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_more_check_update"
                    style="@style/ZySettingsIcon"
                    android:src="@drawable/more_check_update" />
                <TextView style="@style/ZySettingsTitle" android:text="@string/more_check_update" />
                <TextView
                    android:id="@+id/tv_more_version"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/more_version"
                    android:textColor="@color/more_text_light"
                    android:textSize="14sp" />
                <TextView style="@style/ZySettingsChevron" android:text="›" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/v_more_about"
                style="@style/ZySettingsRow"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_more_about"
                    style="@style/ZySettingsIcon"
                    android:src="@drawable/more_about" />
                <TextView style="@style/ZySettingsTitle" android:text="@string/more_about" />
                <TextView style="@style/ZySettingsChevron" android:text="›" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
