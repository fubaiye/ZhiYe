<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="226dp"
    android:minHeight="226dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <ImageView
        android:id="@+id/iv_item_category_novel_cover"
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:background="@drawable/zy_cover_bg"
        android:elevation="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/default_cover" />

    <TextView
        android:id="@+id/tv_item_category_novel_name"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_below="@id/iv_item_category_novel_cover"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical"
        android:maxLines="1"
        android:text="@string/item_category_novel_name"
        android:textColor="@color/item_category_novel_name"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_item_category_novel_author"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_below="@id/tv_item_category_novel_name"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="start|center_vertical"
        android:maxLines="1"
        android:text="公开书源"
        android:textColor="@color/zy_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_item_category_novel_rating"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_below="@id/tv_item_category_novel_author"
        android:fontFamily="sans-serif-medium"
        android:gravity="start|center_vertical"
        android:text="★ 4.8"
        android:textColor="@color/discovery_rating"
        android:textSize="12sp" />

</RelativeLayout>
