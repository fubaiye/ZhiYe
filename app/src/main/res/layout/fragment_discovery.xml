<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/discovery_bg">

    <View
        android:id="@+id/v_discovery_search_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/discovery_search_bar_height"
        android:layout_marginStart="24dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/zy_search_bar"
        android:clickable="true"
        android:elevation="@dimen/zy_elevation_card"
        android:focusable="true"
        app:layout_constraintEnd_toStartOf="@id/tv_discovery_all_book"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_discovery_search_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="18dp"
        android:src="@drawable/zy_ic_discover_outline"
        app:layout_constraintBottom_toBottomOf="@id/v_discovery_search_bg"
        app:layout_constraintStart_toStartOf="@id/v_discovery_search_bg"
        app:layout_constraintTop_toTopOf="@id/v_discovery_search_bg" />

    <TextView
        android:id="@+id/tv_discovery_search_indicator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:text="@string/discovery_search_hint"
        android:textColor="@color/discovery_search_text_indicator"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/v_discovery_search_bg"
        app:layout_constraintEnd_toEndOf="@id/v_discovery_search_bg"
        app:layout_constraintStart_toEndOf="@id/iv_discovery_search_icon"
        app:layout_constraintTop_toTopOf="@id/v_discovery_search_bg" />

    <TextView
        android:id="@+id/tv_discovery_all_book"
        android:layout_width="96dp"
        android:layout_height="@dimen/discovery_search_bar_height"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/zy_card"
        android:clickable="true"
        android:elevation="@dimen/zy_elevation_card"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/discovery_all_book"
        android:textColor="@color/selector_discovery_all_book_text"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <android.support.constraint.ConstraintLayout
        android:id="@+id/cl_discovery_featured"
        android:layout_width="0dp"
        android:layout_height="148dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/zy_card"
        android:elevation="@dimen/zy_elevation_card"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_discovery_search_bg">

        <TextView
            android:id="@+id/tv_discovery_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/discovery_today_title"
            android:textColor="@color/zy_text_primary"
            android:textSize="21sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tv_discovery_start_reading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_discovery_today_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/discovery_today_rating"
            android:textColor="@color/discovery_rating"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_discovery_today" />

        <TextView
            android:id="@+id/tv_discovery_today_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:text="@string/discovery_today_subtitle"
            android:textColor="@color/zy_text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_discovery_today_stars" />

        <TextView
            android:id="@+id/tv_discovery_start_reading"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/zy_featured_button"
            android:clickable="true"
            android:elevation="1dp"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="96dp"
            android:text="@string/discovery_today_action"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </android.support.constraint.ConstraintLayout>

    <LinearLayout
        android:id="@+id/ll_discovery_chips"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_discovery_featured">

        <TextView
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/zy_chip_selected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/discovery_chip_xuanhuan"
            android:textColor="@color/discovery_chip_text_selected"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/zy_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/discovery_chip_city"
            android:textColor="@color/discovery_chip_text_normal"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/zy_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/discovery_chip_history"
            android:textColor="@color/discovery_chip_text_normal"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/zy_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/discovery_chip_mystery"
            android:textColor="@color/discovery_chip_text_normal"
            android:textSize="14sp" />
    </LinearLayout>

    <com.feng.freader.rewrite.TabLayout
        android:id="@+id/tv_discovery_tab_layout"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:background="@color/discovery_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_discovery_chips"
        app:tabIndicatorColor="@color/zy_primary"
        app:tabIndicatorHeight="3dp" />

    <android.support.v4.view.ViewPager
        android:id="@+id/vp_discovery_view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_discovery_tab_layout" />

</android.support.constraint.ConstraintLayout>
